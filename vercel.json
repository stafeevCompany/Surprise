{
  "version": 2,
  "builds": [
    {
      "src": "LoveSite/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "LoveSite/wsgi.py"
    }
  ],
  "static": {
    "public": "LoveSite/staticfiles"
  }
}